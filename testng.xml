<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests" thread-count="5">


	<listeners>
		<listener class-name="utils.Listeners"></listener>
		<listener class-name="utils.RetryAnalyzer"></listener>
	</listeners>

	<test thread-count="5" name="ChromeTest">
		<parameter name="url" value="amazon.in"></parameter>
		<parameter name="browser" value="chrome"></parameter>
		<groups>
			<run>
				<include name="smoke"></include>
				<include name="batch1"></include>
				<exclude name="batch2"></exclude>
			</run>
		</groups>
		<classes>
			<class name="tests.loginTest" />
		</classes>
	</test> <!--
	Test -->


	<test thread-count="5" name="Test">
		<groups>
			<run>
				<include name="smoke"></include>
				<include name="batch2"></include>
				<exclude name="batch1"></exclude>
			</run>
		</groups>
		<classes>
			<class name="tests.loginTest" />
		</classes>
	</test> <!--
	Test -->

</suite> <!--
Suite -->
